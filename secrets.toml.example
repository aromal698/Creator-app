# Safe examples only. Put real values in the relevant Streamlit app's Secrets.
# Never upload secrets.toml, the service-role key, or any real API key to GitHub.
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "your-supabase-publishable-or-anon-key"
GROQ_API_KEY = "paste-your-groq-api-key-here"
GROQ_MODEL = "openai/gpt-oss-20b"
CLOUDFLARE_ACCOUNT_ID = "your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN = "your-cloudflare-workers-ai-token"
CLOUDFLARE_MODEL = "@cf/google/gemma-4-26b-a4b-it"
# Creator app only — keep these in creator_app.py's Streamlit Secrets.
SUPABASE_SERVICE_ROLE_KEY = "creator-app-only-service-role-key"
CAMPUS_CREATOR_PASSWORD = "choose-a-long-private-password"
CAMPUS_CREATOR_NAME = "Campus Creator"
# Optional: used only for reading uploaded poster images in Creator Studio.
GEMINI_API_KEY = "paste-your-gemini-api-key-here"
GEMINI_MODEL = "gemini-3.5-flash-lite"
