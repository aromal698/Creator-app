# Safe examples only. Put real values in the relevant Streamlit app's Secrets.
# Never upload secrets.toml, the service-role key, or any real API key to GitHub.
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "your-supabase-publishable-or-anon-key"
GROQ_API_KEY = "paste-your-groq-api-key-here"
GROQ_MODEL = "openai/gpt-oss-20b"
# Creator app only — keep these in creator_app.py's Streamlit Secrets.
SUPABASE_SERVICE_ROLE_KEY = "creator-app-only-service-role-key"
CAMPUS_CREATOR_PASSWORD = "choose-a-long-private-password"
CAMPUS_CREATOR_NAME = "Campus Creator"
# Optional: image-reading model for event posters. May incur usage charges.
GROQ_VISION_MODEL = "qwen/qwen3.8-27b"
# Student app Google sign-in. Replace every value with your Google OAuth client values.
[auth]
redirect_uri = "https://your-student-app.streamlit.app/oauth2callback"
cookie_secret = "replace-with-a-long-random-private-string"
client_id = "your-google-oauth-client-id"
client_secret = "your-google-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
expose_tokens = ["id"]
